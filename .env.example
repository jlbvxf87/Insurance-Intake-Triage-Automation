# ===========================================================================
# Insurance Intake & Triage Automation — environment template
# ===========================================================================
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
#
#   cp .env.example .env.local
#
# Every variable below is READ SERVER-SIDE ONLY. None are prefixed with
# NEXT_PUBLIC_, so none are ever bundled into client JavaScript.
# ===========================================================================


# ---------------------------------------------------------------------------
# Document extraction provider
# ---------------------------------------------------------------------------
# Which extraction adapter the workflow uses.
#   fixture -> deterministic local fixtures. No network calls. Demo mode.
#   azure   -> Azure AI Document Intelligence. Requires the two vars below.
#   auto    -> use azure when endpoint + key are both present, else fixture.
EXTRACTION_PROVIDER=auto


# ---------------------------------------------------------------------------
# Azure AI Document Intelligence
# ---------------------------------------------------------------------------
# Azure Portal -> your Document Intelligence resource -> Keys and Endpoint.
# Leave blank to run the project in fixture/demo mode.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Model to analyze with. `prebuilt-document` needs no training and returns
# general key/value pairs. A custom-trained model id can be substituted once
# an ACORD/dec-page model is trained in Document Intelligence Studio.
AZURE_DOCUMENT_INTELLIGENCE_MODEL_ID=prebuilt-document

# Document Intelligence REST API version.
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30

# Milliseconds before an analyze operation is abandoned and the submission is
# sent to the Exception queue.
AZURE_REQUEST_TIMEOUT_MS=30000


# ---------------------------------------------------------------------------
# Business rules — tunable thresholds
# ---------------------------------------------------------------------------
# Minimum mean field confidence (0..1) required to accept an extraction
# without human review. Anything below routes to the Review queue.
EXTRACTION_CONFIDENCE_THRESHOLD=0.80

# A submission from the same client, same submission type, and same line of
# business inside this many days is flagged as a possible duplicate.
DUPLICATE_WINDOW_DAYS=30

# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_MB=10


# ---------------------------------------------------------------------------
# Dataverse (optional — only when running against a real environment)
# ---------------------------------------------------------------------------
# Left blank, the app uses the in-memory synthetic repository so the public
# demo never touches a live CRM.
DATAVERSE_ENVIRONMENT_URL=
DATAVERSE_TENANT_ID=
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=


# ---------------------------------------------------------------------------
# Notifications (optional)
# ---------------------------------------------------------------------------
# Acknowledgement email transport. Blank = confirmation events are recorded in
# the automation log but no mail is sent.
NOTIFICATION_PROVIDER=log
NOTIFICATION_FROM_ADDRESS=
